{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd",
            "env": {},
            "args": [],
            "cwd": "${workspaceFolder}/backend",
            "showLog": true,
            "logOutput": "rpc"
        },
        {
            "name": "Frontend",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}/frontend",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Debug Chromium",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend/app",
            "runtimeExecutable": "/Applications/Chromium.app/Contents/MacOS/Chromium",
            "runtimeArgs": [
                "--remote-debugging-port=9222",
                "--user-data-dir=${workspaceFolder}/.vscode/chrome-debug-profile",
                "--no-first-run",
                "--disable-extensions"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Both",
            "configurations": ["Backend", "Frontend", "Debug Chromium"]
        },
        {
            "name": "Front+Debug",
            "configurations": ["Frontend", "Debug Chromium"]
        }
    ]
}